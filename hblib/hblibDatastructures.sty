%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V QueueArray
% \hQueueArray{capacity}{head}{tail}{size}{A,B,C}[box width][box height]
% The queue as it sits in a circular array, with a size counter:
%   head = index of the front element, tail = index where the next element goes,
%   size = number of elements.  The elements are given in QUEUE order (front first)
%   and are drawn at (head + k) mod capacity, so a wrapped queue is drawn correctly.
%   head is yellow, the free slot at tail is green, the elements in the queue are red,
%   the other slots are grey.  A full queue (size = capacity) has head = tail.
\NewDocumentCommand{\hQueueArray}{m m m m m O{0.6} O{0.5}}{%
	\edef\qcap{#1}%
	\edef\qhead{#2}%
	\edef\qtail{#3}%
	\edef\qsize{#4}%
	\def\qwidth{#6}%
	\def\qheight{#7}%
	\def\qy{-.3}%
	\def\qyshf{\qy+\qheight+0.11}%
	\def\qyindex{\qy-0.14}%
	\pgfmathtruncatemacro{\qlast}{\qcap-1}%
	% the slots
	\foreach \i in {0,...,\qlast} {%
		\pgfmathtruncatemacro{\qrel}{mod(\i-\qhead+\qcap,\qcap)}%
		\ifnum\qsize=0
			\ifnum\i=\qhead \def\qfill{colorEmpty}\else\def\qfill{colorUnused}\fi
		\else
			\ifnum\i=\qhead
				\def\qfill{colorHead}%
			\else
				\ifnum\i=\qtail
					\ifnum\qsize=\qcap \def\qfill{colorHead}\else\def\qfill{colorTail}\fi
				\else
					\ifnum\qrel<\qsize \def\qfill{colorUsed}\else\def\qfill{colorUnused}\fi
				\fi
			\fi
		\fi
		\filldraw[fill=\qfill] (\i*\qwidth,\qy) rectangle +(\qwidth,\qheight);
		\node[colorIndex] at (\i*\qwidth+\qwidth/2,\qyindex) {{\tiny \i}};
	}%
	% the elements, in queue order, starting at head
	\foreach \elem [count=\qk] in {#5} {%
		\pgfmathtruncatemacro{\qpos}{mod(\qhead+\qk-1,\qcap)}%
		\node at (\qpos*\qwidth+\qwidth/2,\qy+\qheight/2) {{\scriptsize \elem}};
	}%
	% head and tail marks
	\pgfmathsetmacro{\qxh}{\qhead*\qwidth+\qwidth/4}%
	\pgfmathsetmacro{\qxt}{\qtail*\qwidth+\qwidth*3/4}%
	\node[font=\tiny, text=red!70!black] at (\qxh,\qyshf) {h};
	\node[font=\tiny, text=red!70!black] at (\qxt,\qyshf) {t};
} % \hQueueArray
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A QueueArray





%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V Stack
% Define \stack macro
% if \first=1 then index=0 is not used. Stack starts at index=0
%                else Stack starts at index=1.
% See CLRS
\NewDocumentCommand{\hStack}{m m m m O{0.5} O{0.5}}{ 
	\edef\first{#1}  % first index: 0 or 1
	\edef\capacity{#2}  % capacity
	\edef\top{#3}  % index of top
	\edef\content{#4} % comma separated list
	\def\width{#5} % box width
	\def\height{#6} % box height
	%
	\def\xtt{\width*7/8} % x displacement for  top mark
	\def\y{-.3} % y 
	\def\yshf{\y+\height/4} % y displacement for stack, head. tail mark
	\def\yindex{\y+\height-0.06} % y displacement for indices

	% Draw  rectangles
	% index=0
	\ifnum\first=1
		\filldraw[fill=colorBoxZero] (0,\y) rectangle +(\width,\height);
		\node[colorIndex] at (\width/2,\yindex) {{\tiny 0}}; % index 0
	\fi
	% index>0
	\foreach \j in {1,...,\capacity} {
		\ifnum\first=1
			\FPeval{i}{clip(\j)};
		\else
			\FPeval{i}{clip(\j-1)};
		\fi
		\FPeval{x}{clip(\i*\width)};
	
		\ifnum\i<\top 
			% box is in the stack
			\filldraw[fill=colorUsed] (\x,\y) rectangle +(\width,\height);
		\fi
		\ifnum\i=\top 
			% box is the top element
			\filldraw[fill=colorTop] (\x,\y) rectangle +(\width,\height);
			\node[red] at (\x+\xtt,\yshf) {{\tiny t}};
		\fi
		\ifnum\i>\top 
			% box is not in the stack
			\filldraw[fill=colorUnused] (\x,\y) rectangle +(\width,\height);
		\fi
		
		% index
		\FPeval{xindex}{\i*\width+\width/2};
		\node[colorIndex] at (\xindex,\yindex) {{\tiny \i}}; % index
	}
	% draw the elements
	\foreach \elem [count=\i] in \content {
		\ifnum\first=1
			\FPeval{j}{\i}
		\else
			\FPeval{j}{clip(\i-1)}
		\fi
		\FPeval{x}{\j*\width+\width/2};
		\node at (\x,\y+\height/2) {{\scriptsize \elem}}; % content
	}
}  % \hStack 
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A Stack




%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V String
% \hString[box width]{c,h,a,r,s}[from][to]   (use inside a tikzpicture)
% One box per character with its 0-based index above it.
% Boxes from <= i < to are highlighted, as in s.substring(from, to).
% A space can be given as \textvisiblespace.
\NewDocumentCommand{\hString}{O{0.45} m O{-1} O{-1}}{%
	\foreach \hb@c [count=\hb@i from 0] in {#2} {%
		\ifnum\hb@i<#3\relax \def\hb@fill{white}%
		\else\ifnum\hb@i<#4\relax \def\hb@fill{colorHead}%
		\else \def\hb@fill{white}\fi\fi
		\filldraw[fill=\hb@fill] (\hb@i*#1,0) rectangle +(#1,#1);
		\node[font=\ttfamily\small, text height=1.6ex, text depth=0.3ex, inner sep=0pt]
			at (\hb@i*#1+#1/2,#1/2) {\hb@c};
		\node[colorIndex, font=\tiny] at (\hb@i*#1+#1/2,#1+0.14) {\hb@i};
	}%
} % \hString
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A String




%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V Tree
% TikZ styles for trees drawn with TikZ's child syntax:
%   \begin{tikzpicture}[htree]
%     \node[hnode] {A} child {node[hnode, hhot] {B}} child[missing] child {node[hnode, horder=3] {C}};
%   \end{tikzpicture}
% htree        level distance and edges           hnode   a round node
% hhot         highlighted (the current node)     hdone   already visited
% hleaf        a leaf                             horder=k  small visit number k at the node
% hsquare      a square node (e.g. an operator or a folder)
\tikzset{
	htree/.style={level distance=0.95cm, edge from parent/.style={draw, thick, gray!70},
		every node/.style={font=\small}},
	hnode/.style={circle, draw, thick, fill=white, minimum size=0.58cm, inner sep=1pt},
	hsquare/.style={rectangle, draw, thick, fill=white, minimum size=0.55cm, inner sep=2pt, rounded corners=1pt},
	hhot/.style={fill=colorTop},
	hdone/.style={fill=colorUsed!55},
	hleaf/.style={fill=colorHead!45},
	horder/.style={label={[font=\scriptsize\bfseries, text=red!75!black, inner sep=1pt]above right:#1}}
}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A Tree




%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V Commit graph
% TikZ styles for commit graphs (version control):
%   \node[hcommit] (c1) at (0,0) {a1}; \node[hcommit] (c2) at (1.2,0) {b2};
%   \draw[hparent] (c2) -- (c1);                        % a commit points to its parent
%   \node[hbranch, above=2pt of c2] {main};  \node[hheadref, above=2pt of ...] {HEAD};
% hcommit   a commit              hbranch   a branch name       hheadref  HEAD
% htag      a tag                 hparent   child -> parent     hhot / hdone  colour a commit
\tikzset{
	hcommit/.style={circle, draw, thick, fill=white, minimum size=0.62cm, inner sep=0pt, font=\ttfamily\scriptsize},
	hbranch/.style={rectangle, rounded corners=2pt, draw, fill=colorHead!60, font=\ttfamily\scriptsize, inner sep=2pt},
	hheadref/.style={hbranch, fill=colorTop!60},
	htag/.style={hbranch, fill=gray!20, sharp corners},
	hparent/.style={-latex, thick, gray!70!black}
}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A Commit graph


